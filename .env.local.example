# Salin file ini jadi .env.local, lalu isi dengan nilai dari:
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Nomor WhatsApp bisnis untuk tombol "Pesan via WhatsApp" (format 628xxxxxxxxxx)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Link sosial untuk halaman /kontak — kosongkan dulu kalau belum ada linknya
NEXT_PUBLIC_IG_URL=
NEXT_PUBLIC_SHOPEE_URL=
NEXT_PUBLIC_TOKOPEDIA_URL=
NEXT_PUBLIC_TIKTOK_URL=
